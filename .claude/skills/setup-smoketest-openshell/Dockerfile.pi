# Trial image for setup-smoketest-openshell: pi (coding agent) on Node 22, plus the
# OpenShell supervisor copied from the matching OpenShell sandbox base image.
#
# Build (from the skill folder, with the sandbox disabled if your shell needs it):
#   docker build -t trial-pi:local -f Dockerfile.pi .
#
# Same layout as Dockerfile; only the agent differs. pi is a node script, so the process
# that talks to the network is /usr/local/bin/node (the provider policy rule already allows it).
FROM node:22-bookworm-slim

COPY --from=ghcr.io/nvidia/openshell/sandbox:0.1.5 /openshell-sandbox /openshell-sandbox

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @mariozechner/pi-coding-agent@0.73.1 \
    && pi --version

WORKDIR /sandbox
ENTRYPOINT ["/openshell-sandbox"]
